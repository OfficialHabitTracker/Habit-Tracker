# Local Express port only; Vercel runs the exported app without opening this port.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# In Vercel, set CLIENT_ORIGIN to the deployed Client URL (comma-separated for multiple origins).
# COOKIE_SAME_SITE defaults to lax; production browser requests use the Client origin.

# Set DATABASE_URL to the full connection URL or use the DB_* fields below.
# DATABASE_URL takes precedence when both forms are present.
# DATABASE_URL=mysql://your_user:your_password@your_host.db.enzonic.com:3306/main
# Enzonic MySQL uses port 3306.
DB_HOST=your_database_host_here
DB_PORT=3306
DB_USER=your_database_user_here
DB_PASSWORD=your_database_password_here
# Use the database name shown by your provider (Enzonic MySQL databases use main).
DB_NAME=main
# Enzonic requires verified TLS; DB_SSL_CA is only needed for providers using a private CA.
DB_SSL=false
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

JWT_SECRET=replace-with-a-long-random-secret

# Signup verification mail. For Gmail SMTP, use a Google App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=you@example.com
