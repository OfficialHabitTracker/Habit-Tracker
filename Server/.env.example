# Local Express port only; Vercel runs the exported app without opening this port.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# In Vercel, set CLIENT_ORIGIN to the deployed Client URL (comma-separated for multiple origins).
# COOKIE_SAME_SITE defaults to none on Vercel and lax locally.

# Use the host and assigned port from your Aiven service connection information.
DB_HOST=your_aiven_host_here
DB_PORT=10613
DB_USER=avnadmin
DB_PASSWORD=your_database_password_here
DB_NAME=Habit_Tracker
# Optional verified TLS for Aiven. Set true and paste the Aiven project CA PEM into DB_SSL_CA.
DB_SSL=false
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

JWT_SECRET=replace-with-a-long-random-secret

# Signup verification mail. For Gmail SMTP, use a Google App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=you@example.com
