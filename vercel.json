{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "installCommand": "npm ci --prefix Client && npm ci --prefix Server",
  "buildCommand": "npm run build",
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/signup", "destination": "/index.html" },
    { "source": "/otp", "destination": "/index.html" },
    { "source": "/today", "destination": "/index.html" },
    { "source": "/tomorrow", "destination": "/index.html" },
    { "source": "/history", "destination": "/index.html" },
    { "source": "/week", "destination": "/index.html" }
  ]
}
